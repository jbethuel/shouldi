# TypeSafe (https://typesafe.ai)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Upstash Redis. The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret for the IP address hash, for example: openssl rand -hex 32
IP_HASH_SECRET=

# Comma-separated extension origins, for example chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Leave empty only in development: then any chrome-extension:// origin is allowed.
ALLOWED_ORIGINS=

# Limits (defaults shown)
LIMIT_PER_INSTALL_PER_DAY=50
LIMIT_PER_IP_PER_DAY=200
DAILY_COST_LIMIT_USD=5
JEV_USD_PER_MILLION_INPUT_TOKENS=0.042
STATS_RETENTION_DAYS=90
